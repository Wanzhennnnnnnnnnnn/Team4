<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} | BuildLink Supplier</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        :root {
            --primary: #5B8DEF;
            --primary-hover: #4A7DE0;
            --primary-light: #E8F0FE;
            --border: #C5D5E8;
        }
    </style>
</head>

<body class="bg-gradient-to-br from-[#F8FAFC] to-[#EEF2F7] text-slate-900">

    <div class="flex h-screen overflow-hidden">

        <aside class="w-52 bg-white/80 backdrop-blur-md border-r border-[#C5D5E8] flex flex-col hidden md:flex shrink-0 transition-all duration-300">

            <div class="h-16 flex items-center gap-3 px-6 border-b border-[#C5D5E8]/50">
                <div class="bg-gradient-to-br from-[#5B8DEF] to-[#4A7DE0] p-2 rounded-lg shrink-0">
                    <i data-lucide="store" class="w-6 h-6 text-white"></i>
                </div>
                <span class="text-xl font-bold text-gray-800 tracking-tight">BuildLink</span>
            </div>

            <nav class="flex-1 p-4 space-y-2 overflow-y-auto">
                <a href="/supplier/dashboard"
                    class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 text-base {{#isDashboard}}bg-[#E8F0FE] text-[#4A7DE0] font-medium{{/isDashboard}} {{^isDashboard}}text-gray-600 hover:bg-[#F0F5FF] hover:text-gray-800{{/isDashboard}}">
                    <i data-lucide="layout-dashboard" class="w-5 h-5 shrink-0"></i>
                    <span>Dashboard</span>
                </a>

                <a href="/supplier/orders"
                    class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 text-base {{#isOrders}}bg-[#E8F0FE] text-[#4A7DE0] font-medium{{/isOrders}} {{^isOrders}}text-gray-600 hover:bg-[#F0F5FF] hover:text-gray-800{{/isOrders}}">
                    <i data-lucide="package" class="w-5 h-5 shrink-0"></i>
                    <span>Orders</span>
                </a>

                <a href="/supplier/messages"
                    class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 text-base {{#isMessages}}bg-[#E8F0FE] text-[#4A7DE0] font-medium{{/isMessages}} {{^isMessages}}text-gray-600 hover:bg-[#F0F5FF] hover:text-gray-800{{/isMessages}}">
                    <i data-lucide="message-square" class="w-5 h-5 shrink-0"></i>
                    <span>Messages</span>
                    {{#messageCount}}
                    <span class="ml-auto bg-blue-500 text-white text-xs font-bold px-2 py-0.5 rounded-full">
                        {{messageCount}}
                    </span>
                    {{/messageCount}}
                </a>

                <a href="/supplier/profile"
                    class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 text-base {{#isProfile}}bg-[#E8F0FE] text-[#4A7DE0] font-medium{{/isProfile}} {{^isProfile}}text-gray-600 hover:bg-[#F0F5FF] hover:text-gray-800{{/isProfile}}">
                    <i data-lucide="user" class="w-5 h-5 shrink-0"></i>
                    <span>Profile</span>
                </a>
            </nav>

            <div class="p-4 border-t border-[#C5D5E8]/50">
                <a href="/logout"
                    class="flex items-center gap-3 px-4 py-3 text-base text-gray-400 hover:text-red-500 transition-colors rounded-xl hover:bg-red-50">
                    <i data-lucide="log-out" class="w-5 h-5 shrink-0"></i>
                    <span>Sign Out</span>
                </a>
            </div>
        </aside>

        <div class="flex-1 flex flex-col h-screen overflow-hidden">

            <header class="bg-white/50 backdrop-blur-sm border-b border-[#C5D5E8]/50 h-16 flex items-center justify-between px-8 sticky top-0 z-20">

                <div class="flex items-center gap-4 md:hidden">
                    <span class="font-bold text-xl text-gray-800">BuildLink</span>
                </div>

                <div class="hidden md:block text-sm text-gray-500 font-medium">
                    Supplier Portal <span class="mx-2 text-[#C5D5E8]">/</span> {{title}}
                </div>

                <div class="flex items-center gap-6">
                    <a href="/supplier/messages" class="relative p-1.5 text-gray-400 hover:text-[#4A7DE0] transition-colors">
                        <i data-lucide="message-square" class="w-6 h-6"></i>
                        {{#messageCount}}
                        <span class="absolute top-1 right-1 flex h-2.5 w-2.5 items-center justify-center rounded-full bg-blue-500 ring-2 ring-white"></span>
                        {{/messageCount}}
                    </a>

                    <div class="flex items-center gap-4 pl-4 border-l border-[#C5D5E8]">
                        <div class="text-right hidden sm:block">
                            <div class="text-sm font-bold text-gray-800">{{supplierName}}</div>
                            <div class="text-xs text-gray-500">Supplier</div>
                        </div>
                        <a href="/supplier/profile"
                           class="h-10 w-10 bg-white rounded-full flex items-center justify-center border border-[#C5D5E8] text-[#4A7DE0] hover:bg-[#5B8DEF] hover:text-white transition-all shadow-sm">
                            <i data-lucide="store" class="w-5 h-5"></i>
                        </a>
                    </div>
                </div>
            </header>

            <main class="flex-1 overflow-auto p-6 md:p-8">
                <div class="max-w-7xl mx-auto h-full flex flex-col">
                    {{{ content }}}
                </div>
            </main>
        </div>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>

</html>
