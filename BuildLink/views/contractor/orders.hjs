<div class="space-y-6 max-w-5xl mx-auto">
    
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <div>
            <h2 class="text-2xl font-bold text-slate-800">Track Orders</h2>
            <p class="text-slate-500 text-sm mt-1">Monitor shipment status and delivery progress.</p>
        </div>

        <div class="flex items-center gap-3">
            <div class="relative">
                <i data-lucide="filter" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                <select onchange="window.location.href='/contractor/orders?projectId=' + this.value" 
                        class="pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:border-blue-500 shadow-sm cursor-pointer appearance-none min-w-[200px]">
                    <option value="">All Projects</option>
                    {{#projects}}
                    <option value="{{ProjectID}}" {{selected}}>{{ProjectName}}</option>
                    {{/projects}}
                </select>
            </div>

            <a href="/contractor/dashboard" class="text-sm text-slate-500 hover:text-blue-600 flex items-center gap-1 px-3 py-2 bg-white rounded-lg border border-slate-200 shadow-sm transition-colors">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Back
            </a>
        </div>
    </div>

    {{^orders}}
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-12 text-center">
        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-400">
            <i data-lucide="filter-x" class="w-8 h-8"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-800">No orders found</h3>
        <p class="text-slate-500 mb-6">Try selecting a different project or start shopping.</p>
        <a href="/contractor/orders" class="text-sm text-blue-600 hover:underline">Clear Filters</a>
    </div>
    {{/orders}}

    <div class="space-y-6">
        {{#orders}}
        <div id="order-{{POID}}" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md transition-shadow scroll-mt-24">
            
            <div class="bg-slate-50/80 px-6 py-4 border-b border-slate-100 flex flex-wrap gap-4 justify-between items-center">
                <div class="flex items-center gap-4">
                    <div class="bg-white p-2 rounded-lg border border-slate-200 text-[#D4A5A5]">
                        <i data-lucide="package" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 uppercase font-bold tracking-wider">Order Placed</p>
                        <p class="text-sm font-semibold text-slate-800">{{FormattedDate}}</p>
                    </div>
                </div>

                <div class="flex gap-8 text-sm">
                    <div>
                        <p class="text-xs text-slate-500 uppercase font-bold tracking-wider">Total</p>
                        <p class="font-semibold text-slate-800">NT$ {{FormattedTotal}}</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 uppercase font-bold tracking-wider">Order ID</p>
                        <p class="font-mono text-slate-600">#PO-{{POID}}</p>
                    </div>
                </div>

                {{^IsDelivered}}
                <form action="/contractor/orders/{{POID}}/simulate-status" method="POST" class="ml-auto">
                    <button type="submit" class="flex items-center gap-2 px-3 py-1.5 bg-indigo-50 text-indigo-600 rounded-lg text-xs font-bold hover:bg-indigo-100 transition-colors border border-indigo-100">
                        <i data-lucide="refresh-cw" class="w-3 h-3"></i>
                        Next Step (Demo)
                    </button>
                </form>
                {{/IsDelivered}}
            </div>

            <div class="p-6">
                <div class="flex justify-between items-start mb-8">
                    <div>
                        <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                            {{ProjectName}}
                            <span class="px-2 py-0.5 rounded text-[10px] bg-slate-100 text-slate-500 border border-slate-200">
                                {{SupplierName}}
                            </span>
                        </h3>
                        <div class="mt-1 flex items-center gap-4 text-sm">
                            <p class="text-slate-600">
                                Est. Arrival: <span class="font-semibold {{#IsDelivered}}text-green-600{{/IsDelivered}} {{^IsDelivered}}text-slate-800{{/IsDelivered}}">{{FormattedArrival}}</span>
                            </p>
                            {{#TrackingNumber}}
                            <p class="text-blue-600 flex items-center gap-1 bg-blue-50 px-2 py-0.5 rounded border border-blue-100">
                                <i data-lucide="truck" class="w-3 h-3"></i>
                                Tracking: <span class="font-mono font-medium">{{TrackingNumber}}</span>
                            </p>
                            {{/TrackingNumber}}
                        </div>
                    </div>
                </div>

                <div class="relative px-2 mb-4">
                    <div class="absolute top-1/2 left-0 w-full h-1 bg-slate-100 -translate-y-1/2 rounded-full z-0"></div>
                    <div class="absolute top-1/2 left-0 h-1 bg-green-500 -translate-y-1/2 rounded-full z-0 transition-all duration-700 ease-out" 
                         style="width: {{ProgressWidth}}"></div>

                    <div class="relative z-10 flex justify-between w-full">
                        <div class="flex flex-col items-center gap-2">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center border-2 {{#IsPending}}bg-green-500 border-green-500 text-white{{/IsPending}} {{^IsPending}}bg-green-500 border-green-500 text-white{{/IsPending}} transition-colors shadow-sm">
                                <i data-lucide="clipboard-list" class="w-4 h-4"></i>
                            </div>
                            <span class="text-xs font-bold {{#IsPending}}text-green-600{{/IsPending}} text-slate-400">Ordered</span>
                        </div>

                        <div class="flex flex-col items-center gap-2">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center border-2 
                                {{#IsProcessing}}bg-green-500 border-green-500 text-white{{/IsProcessing}} 
                                {{#IsShipped}}bg-green-500 border-green-500 text-white{{/IsShipped}}
                                {{#IsDelivered}}bg-green-500 border-green-500 text-white{{/IsDelivered}}
                                {{^IsProcessing}}{{^IsShipped}}{{^IsDelivered}}bg-white border-slate-200 text-slate-300{{/IsDelivered}}{{/IsShipped}}{{/IsProcessing}} 
                                transition-colors shadow-sm">
                                <i data-lucide="package" class="w-4 h-4"></i>
                            </div>
                            <span class="text-xs font-bold {{#IsProcessing}}text-green-600{{/IsProcessing}} text-slate-400">Processing</span>
                        </div>

                        <div class="flex flex-col items-center gap-2">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center border-2 
                                {{#IsShipped}}bg-green-500 border-green-500 text-white{{/IsShipped}}
                                {{#IsDelivered}}bg-green-500 border-green-500 text-white{{/IsDelivered}}
                                {{^IsShipped}}{{^IsDelivered}}bg-white border-slate-200 text-slate-300{{/IsDelivered}}{{/IsShipped}}
                                transition-colors shadow-sm">
                                <i data-lucide="truck" class="w-4 h-4"></i>
                            </div>
                            <span class="text-xs font-bold {{#IsShipped}}text-green-600{{/IsShipped}} text-slate-400">Shipped</span>
                        </div>

                        <div class="flex flex-col items-center gap-2">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center border-2 
                                {{#IsDelivered}}bg-green-500 border-green-500 text-white{{/IsDelivered}}
                                {{^IsDelivered}}bg-white border-slate-200 text-slate-300{{/IsDelivered}}
                                transition-colors shadow-sm">
                                <i data-lucide="check" class="w-4 h-4"></i>
                            </div>
                            <span class="text-xs font-bold {{#IsDelivered}}text-green-600{{/IsDelivered}} text-slate-400">Delivered</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/orders}}
    </div>
</div>