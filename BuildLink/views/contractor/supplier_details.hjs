<div class="max-w-7xl mx-auto pb-24">

    <!-- 1. 供應商資訊 Header -->
    <div class="mb-8">
        <a href="/contractor/suppliers" class="text-sm text-slate-500 hover:text-blue-600 flex items-center gap-1 mb-4 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Suppliers
        </a>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col md:flex-row items-start justify-between gap-6">
            <div class="flex items-start gap-4">
                <div class="w-16 h-16 rounded-xl bg-[#FFF5F5] flex items-center justify-center text-[#D4A5A5] font-bold text-2xl shrink-0">
                    {{supplier.CompanyName.0}}
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-slate-800">{{supplier.CompanyName}}</h1>
                    <div class="flex flex-wrap gap-x-6 gap-y-2 mt-2 text-sm text-slate-500">
                        <div class="flex items-center gap-2">
                            <i data-lucide="map-pin" class="w-4 h-4 text-slate-400"></i>
                            <span>{{supplier.Address}}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i data-lucide="phone" class="w-4 h-4 text-slate-400"></i>
                            <!-- 加上防呆檢查，確保資料能顯示 -->
                            <span>{{#supplier.PhoneNumber}}{{supplier.PhoneNumber}}{{/supplier.PhoneNumber}}{{^supplier.PhoneNumber}}N/A{{/supplier.PhoneNumber}}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i data-lucide="mail" class="w-4 h-4 text-slate-400"></i>
                            <span>{{#supplier.Email}}{{supplier.Email}}{{/supplier.Email}}{{^supplier.Email}}N/A{{/supplier.Email}}</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-1 bg-emerald-50 px-3 py-1.5 rounded-lg border border-emerald-100 text-emerald-600 font-bold">
                <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                <span>{{supplier.Rating}}</span>
            </div>
        </div>
    </div>

    <form id="orderForm" action="/contractor/cart/add" method="POST">
        <input type="hidden" name="supplier_name" value="{{supplier.CompanyName}}">
        <input type="hidden" name="supplier_id" value="{{supplier.SupplierID}}">
        <input type="hidden" name="cart_data" id="cartDataInput">
        <!-- ★★★ 修改：移除固定的 hidden input，改由下方的 select 控制 ★★★ -->
        
        <!-- 2. 訂單設定 (Order Configuration) -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-8">
            <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
                <i data-lucide="settings-2" class="w-5 h-5 text-[#D4A5A5]"></i> Order Configuration
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                
                <!-- 專案選擇 -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Select Project <span class="text-red-500">*</span></label>
                    <div class="relative">
                        <select name="project_id" id="projectSelect" required onchange="filterWorkItems()"
                                class="w-full appearance-none rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 focus:border-[#D4A5A5] focus:outline-none focus:ring-1 focus:ring-[#D4A5A5]">
                            <option value="" disabled {{^preSelectedProjectId}}selected{{/preSelectedProjectId}}>Select a project...</option>
                            {{#projects}}
                            <option value="{{ProjectID}}" {{#isSelected}}selected{{/isSelected}}>{{ProjectName}}</option>
                            {{/projects}}
                        </select>
                        <i data-lucide="chevron-down" class="absolute right-3 top-3 w-4 h-4 text-slate-400 pointer-events-none"></i>
                    </div>
                </div>

                <!-- ★★★ 新增：工項選擇 (Work Item) ★★★ -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Select Work Item (Optional)</label>
                    <div class="relative">
                        <select name="work_item_id" id="workItemSelect"
                                class="w-full appearance-none rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 focus:border-[#D4A5A5] focus:outline-none focus:ring-1 focus:ring-[#D4A5A5] disabled:bg-slate-50 disabled:text-slate-400">
                            <option value="">-- No Work Item --</option>
                            <!-- Options will be populated by JS -->
                        </select>
                        <i data-lucide="chevron-down" class="absolute right-3 top-3 w-4 h-4 text-slate-400 pointer-events-none"></i>
                    </div>
                </div>

                <!-- 交期選擇 -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Expected Delivery <span class="text-red-500">*</span></label>
                    <input type="date" name="delivery_date" required class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-slate-900 focus:border-[#D4A5A5] focus:outline-none focus:ring-1 focus:ring-[#D4A5A5]">
                </div>
            </div>
        </div>

        <!-- 3. 材料列表 (Table Style) -->
        <div class="space-y-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
                <div class="flex items-center gap-3">
                    <h3 class="text-lg font-bold text-slate-800">Available Materials</h3>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600">{{supplier.items.length}} items found</span>
                </div>
                <!-- 搜尋框：自動填入 searchQuery -->
                <div class="relative w-full md:w-64">
                    <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                    <input type="text" value="{{searchQuery}}" placeholder="Filter materials..." class="w-full pl-9 pr-4 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:border-[#D4A5A5] focus:ring-1 focus:ring-[#D4A5A5] transition-all"
                           onkeydown="if(event.key === 'Enter'){ event.preventDefault(); window.location.href='?q='+this.value + '{{#preSelectedProjectId}}&projectId={{preSelectedProjectId}}{{/preSelectedProjectId}}{{#preSelectedWorkItemId}}&workItemId={{preSelectedWorkItemId}}{{/preSelectedWorkItemId}}'; }">
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-500 font-semibold">
                                <th class="px-6 py-4">Product Name</th>
                                <th class="px-6 py-4 w-[1%] whitespace-nowrap">Category</th>
                                <th class="px-6 py-4 w-[1%] whitespace-nowrap text-right">Price</th>
                                <th class="px-6 py-4 w-[1%] whitespace-nowrap text-right">Stock</th>
                                <th class="px-6 py-4 w-[1%] whitespace-nowrap text-center">Quantity</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            {{#supplier.items}}
                            <tr class="hover:bg-slate-50 transition-colors group">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-lg bg-[#FFF5F5] flex items-center justify-center text-[#D4A5A5] shrink-0">
                                            <i data-lucide="box" class="w-5 h-5"></i>
                                        </div>
                                        <div>
                                            <span class="font-medium text-slate-900 block">{{name}}</span>
                                            <span class="text-xs text-slate-400 font-mono">#{{id}}</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">
                                        {{category}}
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <span class="font-bold text-slate-800">${{price}}</span>
                                    <span class="text-xs text-slate-400 block">/ {{unit}}</span>
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap text-sm text-slate-600">
                                    {{stock}}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <!-- 數量加減控制器 -->
                                    <div class="flex items-center justify-center gap-1">
                                        <button type="button" onclick="updateQty('{{id}}', -1, {{price}})" class="w-8 h-8 flex items-center justify-center rounded-md border border-slate-200 text-slate-500 hover:bg-slate-50 hover:text-[#D4A5A5] transition-colors"><i data-lucide="minus" class="w-4 h-4"></i></button>
                                        <input type="number" id="qty-{{id}}" value="0" min="0" max="{{stock}}" readonly class="w-12 text-center bg-transparent border-none font-bold text-slate-800 focus:ring-0 p-0" data-id="{{id}}" data-price="{{price}}" data-name="{{name}}">
                                        <button type="button" onclick="updateQty('{{id}}', 1, {{price}})" class="w-8 h-8 flex items-center justify-center rounded-md border border-slate-200 text-slate-500 hover:bg-slate-50 hover:text-[#D4A5A5] transition-colors"><i data-lucide="plus" class="w-4 h-4"></i></button>
                                    </div>
                                </td>
                            </tr>
                            {{/supplier.items}}
                            
                            {{^supplier.items}}
                            <tr>
                                <td colspan="5" class="px-6 py-16 text-center text-slate-500">
                                    <div class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-3 text-slate-300">
                                        <i data-lucide="search-x" class="w-6 h-6"></i>
                                    </div>
                                    <p>No materials found matching your search.</p>
                                </td>
                            </tr>
                            {{/supplier.items}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 4. 底部固定結帳欄 -->
        <div class="fixed bottom-0 left-0 md:left-56 right-0 bg-white border-t border-slate-200 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] p-4 z-30">
            <div class="max-w-7xl mx-auto flex items-center justify-between px-4">
                <div class="flex items-center gap-4">
                    <div class="bg-[#FFF5F5] p-2 rounded-lg text-[#D4A5A5] hidden sm:block"><i data-lucide="shopping-cart" class="w-6 h-6"></i></div>
                    <div>
                        <p class="text-xs text-slate-500 uppercase font-bold tracking-wide">Total Estimated Cost</p>
                        <div class="flex items-baseline gap-2">
                            <span class="text-2xl font-bold text-slate-900" id="displayTotal">$0</span>
                            <span class="text-sm text-slate-500" id="displayCount">(0 items)</span>
                        </div>
                    </div>
                </div>
                <button type="button" onclick="submitOrder()" id="checkoutBtn" disabled class="px-8 py-3 bg-[#D4A5A5] text-white font-bold rounded-xl shadow-lg hover:bg-[#C9A0A0] disabled:opacity-50 disabled:cursor-not-allowed transition-all flex items-center gap-2">
                    <i data-lucide="plus" class="w-5 h-5"></i><span>Add to Cart</span>
                </button>
            </div>
        </div>
    </form>
</div>

<!-- ★★★ 新增：從後端傳來的工項資料 (JSON) ★★★ -->
<script>
    // 從後端接收所有工項資料
    const allWorkItems = {{{allWorkItemsJSON}}}; 
    const preSelectedWorkItemId = "{{preSelectedWorkItemId}}";

    function filterWorkItems() {
        const projectId = document.getElementById('projectSelect').value;
        const workItemSelect = document.getElementById('workItemSelect');
        
        // 清空並重置選項
        workItemSelect.innerHTML = '<option value="">-- No Work Item --</option>';
        workItemSelect.disabled = true;

        if (!projectId) return;

        // 篩選出該專案的工項
        const relevantItems = allWorkItems.filter(item => item.ProjectID == projectId);

        if (relevantItems.length > 0) {
            relevantItems.forEach(item => {
                const option = document.createElement('option');
                option.value = item.WorkItemID;
                option.text = item.Name;
                if (item.WorkItemID == preSelectedWorkItemId) {
                    option.selected = true;
                }
                workItemSelect.appendChild(option);
            });
            workItemSelect.disabled = false;
        }
    }

    let cart = {};
    function updateQty(id, change, price) {
        const input = document.getElementById(`qty-${id}`);
        let currentVal = parseInt(input.value) || 0;
        let maxVal = parseInt(input.getAttribute('max')) || 9999;
        let newVal = currentVal + change;
        if (newVal < 0) newVal = 0;
        if (newVal > maxVal) newVal = maxVal;
        input.value = newVal;
        
        // 更新選中行的背景色
        const row = input.closest('tr'); 
        if (newVal > 0) {
            cart[id] = newVal;
            row.classList.add('bg-blue-50/50');
        } else {
            delete cart[id];
            row.classList.remove('bg-blue-50/50');
        }
        calculateTotal();
    }

    function calculateTotal() {
        let totalAmount = 0;
        let totalItems = 0;
        let cartArray = [];
        document.querySelectorAll('input[id^="qty-"]').forEach(input => {
            let qty = parseInt(input.value) || 0;
            if (qty > 0) {
                let price = parseFloat(input.dataset.price);
                let id = input.dataset.id;
                let name = input.dataset.name;
                totalAmount += (qty * price);
                totalItems += qty;
                cartArray.push({ id: id, name: name, qty: qty, price: price });
            }
        });
        document.getElementById('displayTotal').innerText = '$' + totalAmount.toLocaleString();
        document.getElementById('displayCount').innerText = `(${totalItems} items)`;
        document.getElementById('cartDataInput').value = JSON.stringify(cartArray);
        const btn = document.getElementById('checkoutBtn');
        btn.disabled = totalItems <= 0;
    }

    function submitOrder() {
        const projectSelect = document.getElementById('projectSelect');
        if (!projectSelect.value) {
            alert('Please select a project first!');
            projectSelect.focus();
            return;
        }
        document.getElementById('orderForm').submit();
    }

    // 初始化：如果已經有選定的專案，就執行一次篩選
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const autoAddId = urlParams.get('autoAdd');
        
        // 觸發一次工項篩選，確保如果有預選專案，工項選單會跳出來
        filterWorkItems();

        if (autoAddId) {
            const input = document.getElementById(`qty-${autoAddId}`);
            if (input) {
                const price = parseFloat(input.dataset.price);
                // 自動將數量設為 1
                updateQty(autoAddId, 1, price);
                // 滾動到該行
                input.closest('tr').scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }
    });
</script>