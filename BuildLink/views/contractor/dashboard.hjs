<div class="flex flex-col gap-4 h-full">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 shrink-0">
        
        <div class="bg-white rounded-xl p-4 border border-[#F0E6E6] shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-medium text-slate-500 mb-0.5">Active Projects</p>
                <h3 class="text-2xl font-bold text-slate-800">{{activeProjectsCount}}</h3>
            </div>
            <div class="w-10 h-10 rounded-lg bg-[#D4A5A5] flex items-center justify-center text-white shadow-sm">
                <i data-lucide="folder-kanban" class="w-5 h-5"></i>
            </div>
        </div>

        <div class="bg-white rounded-xl p-4 border border-[#F0E6E6] shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-medium text-slate-500 mb-0.5">Total Projects</p>
                <h3 class="text-2xl font-bold text-slate-800">{{activeProjectsCount}}</h3>
            </div>
            <div class="w-10 h-10 rounded-lg bg-[#9F87AF] flex items-center justify-center text-white shadow-sm">
                <i data-lucide="bar-chart-3" class="w-5 h-5"></i>
            </div>
        </div>

        <div class="bg-white rounded-xl p-4 border border-[#F0E6E6] shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-medium text-slate-500 mb-0.5">Pending Orders</p>
                <h3 class="text-2xl font-bold text-slate-800">{{activeOrdersCount}}</h3>
            </div>
            <div class="w-10 h-10 rounded-lg bg-[#C6B79B] flex items-center justify-center text-white shadow-sm">
                <i data-lucide="shopping-cart" class="w-5 h-5"></i>
            </div>
        </div>

        <div class="bg-white rounded-xl p-4 border border-[#F0E6E6] shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-medium text-slate-500 mb-0.5">Total Spend</p>
                <h3 class="text-2xl font-bold text-slate-800 tracking-tight">NT$ {{totalSpent}}</h3>
            </div>
            <div class="w-10 h-10 rounded-lg bg-[#8ABFAA] flex items-center justify-center text-white shadow-sm">
                <i data-lucide="trending-up" class="w-5 h-5"></i>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 flex-1 min-h-0">
        
        <div class="bg-white rounded-xl p-4 border border-[#F0E6E6] shadow-sm flex flex-col overflow-hidden">
            <div class="flex items-center justify-between mb-3 shrink-0">
                <h2 class="text-lg font-bold text-slate-800">Recent Projects</h2>
                <a href="/contractor/projects" class="text-xs text-[#D4A5A5] hover:text-[#C9A0A0] font-medium transition-colors">View All</a>
            </div>

            <div class="space-y-3 overflow-y-auto pr-1">
                <div class="p-3 rounded-lg border border-slate-100 hover:border-[#D4A5A5]/30 hover:shadow-sm transition-all bg-white group cursor-pointer">
                    <div class="flex justify-between items-start">
                        <div>
                            <h4 class="font-bold text-sm text-slate-800 mb-0.5 group-hover:text-[#D4A5A5] transition-colors">Taichung Da-An Sports Center</h4>
                            <p class="text-xs text-slate-500">Da'an Dist, Taichung City</p>
                        </div>
                        <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-blue-50 text-blue-600">
                            Planning
                        </span>
                    </div>
                </div>

                {{^activeProjectsCount}}
                <div class="flex-1 flex flex-col items-center justify-center text-slate-400 py-4">
                    <i data-lucide="folder-open" class="w-8 h-8 mb-2 text-slate-200"></i>
                    <p class="text-xs">No active projects</p>
                </div>
                {{/activeProjectsCount}}
            </div>
        </div>

        <div class="bg-white rounded-xl p-4 border border-[#F0E6E6] shadow-sm flex flex-col overflow-hidden">
            <div class="flex items-center justify-between mb-3 shrink-0">
                <h2 class="text-lg font-bold text-slate-800">Recent Orders</h2>
                <a href="/contractor/orders" class="text-xs text-[#D4A5A5] hover:text-[#C9A0A0] font-medium transition-colors">View All</a>
            </div>

            <div class="flex-1 flex flex-col overflow-y-auto pr-1">
                {{#recentOrders}}
                <div class="space-y-2 w-full mb-2">
                    <div class="flex items-center justify-between p-3 rounded-lg bg-slate-50 border border-slate-100 hover:bg-[#FFF5F5] hover:border-[#F5E6E8] transition-colors">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-md bg-white flex items-center justify-center text-[#D4A5A5] shadow-sm border border-slate-100">
                                <i data-lucide="package" class="w-4 h-4"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-800 text-xs">{{ProjectName}}</h4>
                                <p class="text-[10px] text-slate-500">{{SupplierName}}</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="font-bold text-slate-800 text-sm">NT$ {{TotalAmount}}</div>
                            <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-slate-200 text-slate-600">{{Status}}</span>
                        </div>
                    </div>
                </div>
                {{/recentOrders}}

                {{^recentOrders}}
                <div class="flex flex-col items-center justify-center text-slate-400 h-full py-4">
                    <div class="w-12 h-12 mb-2 rounded-xl bg-[#FAF5F5] flex items-center justify-center transform rotate-12">
                        <i data-lucide="package-open" class="w-6 h-6 text-[#D4A5A5]"></i>
                    </div>
                    <p class="text-xs font-medium text-slate-500">No recent orders</p>
                </div>
                {{/recentOrders}}
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 shrink-0">
        
        <a href="/contractor/projects" class="group bg-white rounded-xl p-4 border border-[#F0E6E6] shadow-sm hover:shadow-md hover:border-[#D4A5A5]/50 transition-all flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-[#FFF5F5] text-[#D4A5A5] flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shrink-0">
                <i data-lucide="folder-kanban" class="w-6 h-6"></i>
            </div>
            <div class="text-left">
                <h3 class="text-sm font-bold text-slate-800">Project Management</h3>
                <p class="text-xs text-slate-500">Create and manage projects</p>
            </div>
        </a>

        <a href="/contractor/materials" class="group bg-white rounded-xl p-4 border border-[#F0E6E6] shadow-sm hover:shadow-md hover:border-[#D4A5A5]/50 transition-all flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-[#FFF5F5] text-[#D4A5A5] flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shrink-0">
                <i data-lucide="package-search" class="w-6 h-6"></i>
            </div>
            <div class="text-left">
                <h3 class="text-sm font-bold text-slate-800">Browse Materials</h3>
                <p class="text-xs text-slate-500">Explore all materials</p>
            </div>
        </a>

        <a href="/contractor/suppliers" class="group bg-white rounded-xl p-4 border border-[#F0E6E6] shadow-sm hover:shadow-md hover:border-[#D4A5A5]/50 transition-all flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-[#FFF5F5] text-[#D4A5A5] flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shrink-0">
                <i data-lucide="trending-up" class="w-6 h-6"></i>
            </div>
            <div class="text-left">
                <h3 class="text-sm font-bold text-slate-800">Supplier Directory</h3>
                <p class="text-xs text-slate-500">Manage connections</p>
            </div>
        </a>

    </div>

    <div class="bg-white rounded-xl p-4 border border-[#F0E6E6] shadow-sm">
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                <i data-lucide="star" class="w-5 h-5 text-amber-500 fill-current"></i>
                Top Rated Suppliers
            </h2>
            <a href="/contractor/suppliers" class="text-xs text-[#D4A5A5] hover:text-[#C9A0A0] font-medium transition-colors">View All</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {{#topSuppliers}}
            <a href="/contractor/supplier/{{SupplierID}}" class="block rounded-lg border border-slate-200 hover:border-[#D4A5A5]/60 hover:shadow-md transition-all p-4 bg-slate-50/50">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="font-bold text-slate-800 text-sm leading-tight">{{SupplierName}}</h3>
                    <div class="flex items-center gap-1 text-amber-500 text-sm font-semibold">
                        <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                        <span>{{Rating}}</span>
                    </div>
                </div>
                <p class="text-xs text-slate-500 line-clamp-2 mb-3">{{Description}}</p>
                <div class="text-[11px] font-semibold text-[#D4A5A5] flex items-center gap-1">
                    View supplier <i data-lucide="arrow-right" class="w-3 h-3"></i>
                </div>
            </a>
            {{/topSuppliers}}

            {{^topSuppliers}}
            <div class="col-span-full text-center text-slate-400 py-4">
                <p class="text-sm">No supplier ratings available yet.</p>
            </div>
            {{/topSuppliers}}
        </div>
    </div>
</div>
