<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-start justify-between">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/contractor/projects" class="text-slate-400 hover:text-blue-600 transition-colors">
                    <i data-lucide="arrow-left" class="w-5 h-5"></i>
                </a>
                <h1 class="text-2xl font-bold text-slate-800">{{project.ProjectName}}</h1>
            </div>
            <div class="flex items-center gap-4 text-sm text-slate-500 ml-7">
                <span class="flex items-center gap-1"><i data-lucide="hash" class="w-3 h-3"></i> ID: {{project.ProjectID}}</span>
                <span class="flex items-center gap-1"><i data-lucide="map-pin" class="w-3 h-3"></i> {{project.Location}}</span>
                <span class="px-2 py-0.5 bg-green-100 text-green-700 rounded-full text-xs font-medium">{{project.Status}}</span>
            </div>
        </div>
        <a href="/contractor/projects/{{project.ProjectID}}/create-po" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 shadow-sm flex items-center gap-2 transition-colors">
            <i data-lucide="plus-circle" class="w-4 h-4"></i>
            <span>New Purchase Order</span>
        </a>
    </div>

    <!-- Work Items Section -->
    <div class="border-t border-slate-200 pt-6 pb-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                <i data-lucide="hammer" class="w-5 h-5 text-slate-400"></i>
                Work Items
            </h3>
            <button onclick="openAddWorkItemModal()" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 shadow-sm flex items-center gap-2 transition-colors text-sm">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Add Work Item</span>
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            {{#workItems}}
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md transition-shadow">
                <div class="px-4 py-3 border-b border-slate-100 bg-slate-50/50">
                    <div class="flex items-start justify-between">
                        <div>
                            <h4 class="font-bold text-slate-800">{{WorkItemName}}</h4>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">
                                    {{WorkItemType}}
                                </span>
                                <span class="px-2 py-0.5 rounded text-xs font-medium {{statusClass}}">
                                    {{Status}}
                                </span>
                            </div>
                        </div>
                        <div class="flex gap-1">
                            <a href="/contractor/work-items/{{WorkItemID}}" class="p-1.5 text-slate-400 hover:text-blue-600 transition-colors" title="View Details">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </a>
                            <a href="/contractor/work-items/{{WorkItemID}}/purchase" class="p-1.5 text-slate-400 hover:text-green-600 transition-colors" title="Purchase Materials">
                                <i data-lucide="shopping-cart" class="w-4 h-4"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="px-4 py-3">
                    {{#Description}}
                    <div class="text-sm text-slate-600 mb-2">{{Description}}</div>
                    {{/Description}}
                    <div class="flex items-center justify-between text-xs text-slate-500">
                        <span><i data-lucide="package" class="w-3 h-3 inline"></i> {{MaterialCount}} materials</span>
                        <span><i data-lucide="check-circle" class="w-3 h-3 inline"></i> {{DeliveredMaterialCount}} delivered</span>
                    </div>
                    {{#EstimatedCost}}
                    <div class="mt-2 pt-2 border-t border-slate-100 flex justify-between text-sm">
                        <span class="text-slate-500">Estimated:</span>
                        <span class="font-bold text-slate-700">${{EstimatedCost}}</span>
                    </div>
                    {{/EstimatedCost}}
                </div>
            </div>
            {{/workItems}}

            {{^workItems}}
            <div class="col-span-2 text-center py-12 bg-white border border-dashed border-slate-200 rounded-xl">
                <div class="inline-flex p-4 rounded-full bg-slate-50 text-slate-400 mb-3">
                    <i data-lucide="hammer" class="w-8 h-8"></i>
                </div>
                <p class="text-slate-400 mb-3">No work items added yet</p>
                <button onclick="openAddWorkItemModal()" class="text-blue-600 hover:text-blue-700 font-medium">
                    Add your first work item
                </button>
            </div>
            {{/workItems}}
        </div>
    </div>

    <!-- Add Work Item Modal -->
    <div id="addWorkItemModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
        <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
            <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
                <h3 class="text-xl font-bold text-slate-800">Add Work Item</h3>
                <button onclick="closeAddWorkItemModal()" class="text-slate-400 hover:text-slate-600">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>

            <form action="/contractor/projects/{{project.ProjectID}}/work-items/add" method="POST" class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Work Item Type <span class="text-red-500">*</span></label>
                    <select name="workItemType" required class="w-full appearance-none rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                        <option value="">Select type...</option>
                        <option value="earthwork">Earthwork</option>
                        <option value="excavation">Excavation</option>
                        <option value="foundation_piling">Foundation Piling</option>
                        <option value="formwork">Formwork</option>
                        <option value="concrete_pouring">Concrete Pouring</option>
                        <option value="steel_fixing">Steel Fixing</option>
                        <option value="scaffolding">Scaffolding</option>
                        <option value="waterproofing">Waterproofing</option>
                        <option value="drainage">Drainage</option>
                        <option value="finishing">Finishing</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Work Item Name <span class="text-red-500">*</span></label>
                    <input type="text" name="workItemName" required placeholder="e.g., Level 3 Formwork Installation" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Description</label>
                    <textarea name="description" rows="3" placeholder="Brief description of the work..." class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"></textarea>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Start Date</label>
                        <input type="date" name="startDate" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">End Date</label>
                        <input type="date" name="endDate" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Estimated Cost ($)</label>
                    <input type="number" name="estimatedCost" step="0.01" placeholder="0.00" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                </div>

                <div class="flex gap-3 pt-4">
                    <button type="button" onclick="closeAddWorkItemModal()" class="flex-1 px-4 py-2.5 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 font-medium">
                        Cancel
                    </button>
                    <button type="submit" class="flex-1 px-4 py-2.5 bg-green-600 text-white rounded-lg hover:bg-green-700 font-medium">
                        Create Work Item
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
    function openAddWorkItemModal() {
        const modal = document.getElementById('addWorkItemModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        // Re-initialize Lucide icons
        lucide.createIcons();
    }

    function closeAddWorkItemModal() {
        const modal = document.getElementById('addWorkItemModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    // Close modal on ESC key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeAddWorkItemModal();
        }
    });

    // Close modal on backdrop click
    document.getElementById('addWorkItemModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeAddWorkItemModal();
        }
    });

    // Re-initialize Lucide icons for work items section
    lucide.createIcons();
    </script>

    <div class="border-t border-slate-200 pt-6">
        <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
            <i data-lucide="package-open" class="w-5 h-5 text-slate-400"></i>
            Order History & Logistics
        </h3>

        <div class="space-y-4">
            {{#orders}}
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex flex-wrap justify-between items-center bg-slate-50/50 gap-4">
                    <div class="flex items-center gap-4">
                        <div class="font-mono text-sm font-bold text-slate-700">PO-{{POID}}</div>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">
                            {{Status}}
                        </span>
                    </div>
                    <div class="text-sm text-right flex items-center gap-6 text-slate-500">
                        <span><strong class="text-slate-700">Supplier:</strong> {{SupplierName}}</span>
                        <span><strong class="text-slate-700">Delivery:</strong> {{DeliveryDate}}</span>
                    </div>
                </div>
                <div class="px-6 py-2">
                    <table class="w-full text-sm">
                        <thead class="text-xs text-slate-400 uppercase font-medium border-b border-slate-100">
                            <tr>
                                <th class="py-3 text-left w-1/2">Material</th>
                                <th class="py-3 text-center">Qty</th>
                                <th class="py-3 text-right">Price</th>
                                <th class="py-3 text-right">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            {{#Items}}
                            <tr>
                                <td class="py-3 font-medium text-slate-700">{{Material}}</td>
                                <td class="py-3 text-center text-slate-500">{{Quantity}}</td>
                                <td class="py-3 text-right text-slate-600">${{Price}}</td>
                                <td class="py-3 text-right">
                                    <span class="text-xs text-blue-600 font-medium">{{../DeliveryStatus}}</span>
                                </td>
                            </tr>
                            {{/Items}}
                        </tbody>
                    </table>
                </div>
            </div>
            {{/orders}}

            {{^orders}}
            <div class="text-center py-12 bg-white border border-dashed border-slate-200 rounded-xl">
                <p class="text-slate-400">No purchase orders found for this project.</p>
            </div>
            {{/orders}}
        </div>
    </div>
</div>