<div class="space-y-6">
    
    <!-- 1. 專案資訊 Header Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-[#E8C5C5] p-6">
        <div class="flex justify-between items-start mb-6">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-[#FFF5F5] rounded-xl flex items-center justify-center text-[#D4A5A5]">
                    <i data-lucide="building" class="w-6 h-6"></i>
                </div>
                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-2xl font-bold text-slate-800">{{project.ProjectName}}</h1>
                    </div>
                    <div class="mt-1">
                        <span class="px-2.5 py-0.5 rounded-lg text-xs font-medium border {{project.StatusClass}}">
                            {{project.StatusLabel}}
                        </span>
                    </div>
                </div>
            </div>
            
            <div class="flex gap-2">
                <button onclick="document.getElementById('editProjectModal').classList.remove('hidden')" 
                        class="px-4 py-2 bg-white border border-slate-200 text-slate-600 rounded-lg hover:bg-slate-50 text-sm font-medium flex items-center gap-2 transition-colors">
                    <i data-lucide="edit-3" class="w-4 h-4"></i>
                    Edit
                </button>
                
                <button onclick="if(confirm('Are you sure you want to delete this project? All related orders and items will be deleted.')) { document.getElementById('deleteProjectForm').submit(); }" 
                        class="px-4 py-2 bg-white border border-red-200 text-red-600 rounded-lg hover:bg-red-50 text-sm font-medium flex items-center gap-2 transition-colors">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                    Delete
                </button>
                <form id="deleteProjectForm" action="/contractor/projects/delete/{{project.ProjectID}}" method="POST" class="hidden"></form>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 py-6 border-t border-slate-100">
            <div>
                <p class="text-xs text-slate-400 mb-1 flex items-center gap-1"><i data-lucide="map-pin" class="w-3 h-3"></i> Location</p>
                <p class="font-medium text-slate-800">{{project.Location}}</p>
            </div>
            <div>
                <p class="text-xs text-slate-400 mb-1 flex items-center gap-1"><i data-lucide="calendar" class="w-3 h-3"></i> Start Date</p>
                <p class="font-medium text-slate-800">{{project.FormattedStartDate}}</p>
            </div>
            <div>
                <p class="text-xs text-slate-400 mb-1 flex items-center gap-1"><i data-lucide="user" class="w-3 h-3"></i> Client</p>
                <p class="font-medium text-slate-800">{{#project.ClientName}}{{project.ClientName}}{{/project.ClientName}}{{^project.ClientName}}-{{/project.ClientName}}</p>
            </div>
            <div class="min-w-[200px]">
                <div class="flex justify-between text-xs mb-1">
                    <span class="text-slate-400 flex items-center gap-1"><i data-lucide="dollar-sign" class="w-3 h-3"></i> Budget</span>
                    <span class="font-bold text-slate-800">{{project.ProgressPercent}}%</span>
                </div>
                <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden mb-1">
                    <div class="bg-[#D4A5A5] h-1.5 rounded-full" style="width: {{project.ProgressPercent}}%"></div>
                </div>
                <p class="text-xs text-slate-400">${{project.FormattedSpent}} / ${{project.FormattedBudget}}</p>
            </div>
        </div>
    </div>

    <div class="flex gap-4 border-b border-slate-200">
        <button onclick="switchTab('workitems')" id="tab-workitems" class="px-4 py-2 text-sm font-medium border-b-2 border-[#D4A5A5] text-[#D4A5A5] transition-colors flex items-center gap-2">
            <i data-lucide="hammer" class="w-4 h-4"></i> Work Items
        </button>
        <button onclick="switchTab('orders')" id="tab-orders" class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition-colors flex items-center gap-2">
            <i data-lucide="shopping-cart" class="w-4 h-4"></i> Order History
        </button>
    </div>

    <div id="content-workitems" class="space-y-4">
        <div class="flex justify-between items-center">
            <h3 class="text-lg font-bold text-slate-800">Work Items List</h3>
            <button onclick="document.getElementById('addWorkItemModal').classList.remove('hidden')" 
                    class="px-3 py-1.5 bg-[#D4A5A5] text-white rounded-lg hover:bg-[#C9A0A0] text-sm font-medium flex items-center gap-1 transition-colors">
                <i data-lucide="plus" class="w-4 h-4"></i> Add Item
            </button>
        </div>

        {{#hasWorkItems}}
        <div class="grid gap-4">
            {{#workItems}}
            <div class="group bg-white p-5 rounded-xl border border-slate-200 hover:shadow-md transition-all relative">
                
                <div class="flex justify-between items-start mb-3">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 bg-slate-50 rounded-lg flex items-center justify-center text-slate-400 group-hover:bg-[#FFF5F5] group-hover:text-[#D4A5A5] transition-colors">
                            <i data-lucide="check-square" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-slate-800 text-lg leading-tight">{{Name}}</h4>
                            <div class="flex items-center gap-2 text-xs text-slate-500 mt-1">
                                <span class="font-medium text-slate-700">Est. Cost: ${{EstimatedCost}}</span>
                                <span>•</span>
                                <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600">{{Status}}</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <!-- 購買按鈕：已傳遞 ProjectID 與 WorkItemID -->
                        <a href="/contractor/materials?projectId={{ProjectID}}&workItemId={{WorkItemID}}" 
                           class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-xs font-medium hover:bg-blue-700 transition-colors flex items-center gap-1 shadow-sm">
                            <i data-lucide="shopping-cart" class="w-3 h-3"></i>
                            Purchase Materials
                        </a>

                        <form action="/contractor/projects/{{ProjectID}}/workitem/delete/{{WorkItemID}}" method="POST" 
                              onsubmit="return confirm('Are you sure you want to delete this item?');">
                            <button type="submit" class="p-1.5 text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors" title="Delete Item">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </form>
                    </div>
                </div>
                
                {{#Description}}
                <p class="text-sm text-slate-600 mb-3 pl-14 leading-relaxed">{{Description}}</p>
                {{/Description}}
                
                <div class="pl-14 flex flex-wrap gap-4 text-xs text-slate-400 border-t border-slate-50 pt-3 mt-2">
                    {{#StartDate}}
                    <div class="flex items-center gap-1">
                        <i data-lucide="calendar" class="w-3 h-3"></i>
                        <span>{{StartDate}} - {{EndDate}}</span>
                    </div>
                    {{/StartDate}}
                    
                    {{#Notes}}
                    <div class="flex items-center gap-1 text-slate-500">
                        <i data-lucide="sticky-note" class="w-3 h-3"></i>
                        <span>{{Notes}}</span>
                    </div>
                    {{/Notes}}
                </div>

                <!-- ★★★ 新增：顯示該工項下的材料列表 ★★★ -->
                <div class="mt-4 ml-14 bg-slate-50/80 rounded-xl p-4 border border-slate-100">
                    <h5 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-2">
                        <i data-lucide="package" class="w-3 h-3"></i> 
                        Allocated Materials
                    </h5>

                    {{#Materials}}
                    <div class="space-y-2">
                        <!-- 單一材料列 -->
                        <div class="flex items-center justify-between bg-white p-2.5 rounded-lg border border-slate-200 shadow-sm">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded bg-[#FFF5F5] flex items-center justify-center text-[#D4A5A5]">
                                    <i data-lucide="box" class="w-4 h-4"></i>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-slate-800">{{MaterialName}}</p>
                                    <p class="text-[10px] text-slate-400">Supplier: {{SupplierName}}</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-sm font-bold text-slate-800">${{TotalPrice}}</p>
                                <p class="text-[10px] text-slate-500">{{Quantity}} {{Unit}}</p>
                            </div>
                        </div>
                    </div>
                    {{/Materials}}

                    {{^Materials}}
                    <div class="text-center py-2">
                        <p class="text-xs text-slate-400 italic">No materials purchased for this item yet.</p>
                    </div>
                    {{/Materials}}
                </div>
                <!-- ★★★ 結束新增 ★★★ -->

            </div>
            {{/workItems}}
        </div>
        {{/hasWorkItems}}

        {{^hasWorkItems}}
        <div class="bg-white rounded-2xl border-2 border-dashed border-[#E8C5C5] p-16 text-center">
            <div class="mx-auto w-16 h-16 bg-[#FFF5F5] rounded-full flex items-center justify-center text-[#D4A5A5] mb-4">
                <i data-lucide="wrench" class="w-8 h-8"></i>
            </div>
            <h4 class="text-slate-600 font-medium mb-4">No work items yet</h4>
            <button onclick="document.getElementById('addWorkItemModal').classList.remove('hidden')" 
                    class="px-4 py-2 bg-[#D4A5A5] text-white rounded-lg hover:bg-[#C9A0A0] text-sm font-medium shadow-sm">
                Create First Item
            </button>
        </div>
        {{/hasWorkItems}}
    </div>

    <div id="content-orders" class="hidden space-y-4">
        <div class="flex justify-between items-center">
            <h3 class="text-lg font-bold text-slate-800">Order History</h3>
            <a href="/contractor/materials?projectId={{project.ProjectID}}" class="px-3 py-1.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm font-medium flex items-center gap-1 transition-colors">
                <i data-lucide="plus" class="w-4 h-4"></i> New Purchase
            </a>
        </div>

        {{#orders}}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between hover:shadow-md transition-all">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-slate-50 rounded-lg flex items-center justify-center text-slate-500">
                    <i data-lucide="file-text" class="w-5 h-5"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-slate-800">PO-{{POID}}</span>
                        <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-600">{{Status}}</span>
                        {{#WorkItemID}}
                        <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-blue-50 text-blue-600 border border-blue-100">Item #{{WorkItemID}}</span>
                        {{/WorkItemID}}
                    </div>
                    <p class="text-xs text-slate-500 mt-0.5">Supplier: {{SupplierName}} • {{OrderDate}}</p>
                </div>
            </div>
            <div class="text-right">
                <div class="font-bold text-slate-800">NT$ {{TotalAmount}}</div>
                <a href="#" class="text-xs text-blue-600 hover:underline">View Details</a>
            </div>
        </div>
        {{/orders}}

        {{^orders}}
        <div class="text-center py-12 bg-slate-50 rounded-xl border border-dashed border-slate-300">
            <p class="text-slate-400">No orders found for this project</p>
        </div>
        {{/orders}}
    </div>

</div>

<div id="editProjectModal" class="fixed inset-0 z-50 hidden">
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm" onclick="document.getElementById('editProjectModal').classList.add('hidden')"></div>
    <div class="fixed inset-0 z-10 overflow-y-auto flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
                <h3 class="text-lg font-bold text-slate-800">Edit Project</h3>
                <button onclick="document.getElementById('editProjectModal').classList.add('hidden')"><i data-lucide="x" class="w-5 h-5 text-slate-400"></i></button>
            </div>
            <form action="/contractor/projects/edit/{{project.ProjectID}}" method="POST">
                <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto">
                    <input type="text" name="projectName" value="{{project.ProjectName}}" required class="w-full border p-2 rounded" placeholder="Project Name">
                    <textarea name="description" class="w-full border p-2 rounded" placeholder="Description">{{project.Description}}</textarea>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <input type="text" name="location" value="{{project.Location}}" class="border p-2 rounded">
                        <select name="status" class="border p-2 rounded">
                            <option value="Planning" {{#project.isPlanning}}selected{{/project.isPlanning}}>Planning</option>
                            <option value="In Progress" {{#project.isInProgress}}selected{{/project.isInProgress}}>In Progress</option>
                            <option value="Completed" {{#project.isCompleted}}selected{{/project.isCompleted}}>Completed</option>
                            <option value="On Hold" {{#project.isOnHold}}selected{{/project.isOnHold}}>On Hold</option>
                        </select>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <input type="date" name="startDate" value="{{project.RawStartDate}}" class="border p-2 rounded">
                        <input type="date" name="endDate" value="{{project.RawEndDate}}" class="border p-2 rounded">
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <input type="number" name="budget" value="{{project.Budget}}" class="border p-2 rounded" placeholder="Budget">
                        <input type="text" name="clientName" value="{{project.ClientName}}" class="border p-2 rounded" placeholder="Client Name">
                    </div>
                    <input type="text" name="clientContact" value="{{project.ClientContact}}" class="border p-2 rounded w-full" placeholder="Client Contact">
                </div>
                <div class="p-4 bg-slate-50 flex justify-end gap-2">
                    <button type="button" onclick="document.getElementById('editProjectModal').classList.add('hidden')" class="px-4 py-2 border rounded bg-white">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-[#D4A5A5] text-white rounded">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="addWorkItemModal" class="fixed inset-0 z-50 hidden">
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm" onclick="document.getElementById('addWorkItemModal').classList.add('hidden')"></div>
    <div class="fixed inset-0 z-10 overflow-y-auto flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl overflow-hidden">
            
            <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
                <h3 class="text-lg font-bold text-slate-800">Add Work Item</h3>
                <button onclick="document.getElementById('addWorkItemModal').classList.add('hidden')">
                    <i data-lucide="x" class="w-5 h-5 text-slate-400"></i>
                </button>
            </div>

            <form action="/contractor/projects/{{project.ProjectID}}/workitem/add" method="POST">
                <div class="p-6 space-y-5 max-h-[70vh] overflow-y-auto">
                    
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Item Name <span class="text-red-500">*</span></label>
                        <input type="text" name="name" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:border-[#D4A5A5] focus:ring-1 focus:ring-[#D4A5A5] outline-none">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Description</label>
                        <textarea name="description" rows="3" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:border-[#D4A5A5] focus:ring-1 focus:ring-[#D4A5A5] outline-none resize-none"></textarea>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
                            <select name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:border-[#D4A5A5] focus:ring-1 focus:ring-[#D4A5A5] outline-none bg-white">
                                <option value="Pending">Pending</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="On Hold">On Hold</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Estimated Cost (NT$)</label>
                            <input type="number" name="estimatedCost" min="0" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:border-[#D4A5A5] focus:ring-1 focus:ring-[#D4A5A5] outline-none">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Start Date</label>
                            <input type="date" name="startDate" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:border-[#D4A5A5] focus:ring-1 focus:ring-[#D4A5A5] outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">End Date</label>
                            <input type="date" name="endDate" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:border-[#D4A5A5] focus:ring-1 focus:ring-[#D4A5A5] outline-none">
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Notes</label>
                        <textarea name="notes" rows="2" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 focus:border-[#D4A5A5] focus:ring-1 focus:ring-[#D4A5A5] outline-none resize-none"></textarea>
                    </div>

                </div>

                <div class="bg-slate-50 px-6 py-4 flex justify-end gap-3 rounded-b-2xl border-t border-slate-100">
                    <button type="button" onclick="document.getElementById('addWorkItemModal').classList.add('hidden')" 
                            class="px-4 py-2 bg-white border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 font-medium transition-colors text-sm">
                        Cancel
                    </button>
                    <button type="submit" 
                            class="px-6 py-2 bg-[#D4A5A5] text-white rounded-lg hover:bg-[#C9A0A0] font-medium transition-colors text-sm shadow-sm">
                        Create Item
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function switchTab(tabName) {
        document.getElementById('content-workitems').classList.add('hidden');
        document.getElementById('content-orders').classList.add('hidden');
        document.getElementById('tab-workitems').classList.remove('border-[#D4A5A5]', 'text-[#D4A5A5]');
        document.getElementById('tab-orders').classList.remove('border-[#D4A5A5]', 'text-[#D4A5A5]');
        
        document.getElementById('content-' + tabName).classList.remove('hidden');
        document.getElementById('tab-' + tabName).classList.add('border-[#D4A5A5]', 'text-[#D4A5A5]');
    }
</script>