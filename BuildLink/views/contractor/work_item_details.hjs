<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-start justify-between">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="/contractor/projects/{{workItem.ProjectID}}" class="text-slate-400 hover:text-blue-600 transition-colors">
                    <i data-lucide="arrow-left" class="w-5 h-5"></i>
                </a>
                <h1 class="text-2xl font-bold text-slate-800">{{workItem.WorkItemName}}</h1>
            </div>
            <div class="flex items-center gap-4 text-sm text-slate-500 ml-7">
                <span class="flex items-center gap-1"><i data-lucide="hash" class="w-3 h-3"></i> ID: {{workItem.WorkItemID}}</span>
                <span class="px-2 py-0.5 bg-blue-100 text-blue-700 rounded-full text-xs font-medium">{{workItem.WorkItemType}}</span>
                <span class="px-2 py-0.5 {{statusClass}} rounded-full text-xs font-medium">{{workItem.Status}}</span>
            </div>
        </div>
        <a href="/contractor/work-items/{{workItem.WorkItemID}}/purchase" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 shadow-sm flex items-center gap-2 transition-colors">
            <i data-lucide="shopping-cart" class="w-4 h-4"></i>
            <span>Purchase Materials</span>
        </a>
    </div>

    <!-- Work Item Info Card -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <p class="text-sm text-slate-500 mb-1">Project</p>
                <p class="font-semibold text-slate-800">{{projectName}}</p>
            </div>
            <div>
                <p class="text-sm text-slate-500 mb-1">Duration</p>
                <p class="font-semibold text-slate-800">{{workItem.StartDate}} — {{workItem.EndDate}}</p>
            </div>
            <div>
                <p class="text-sm text-slate-500 mb-1">Budget</p>
                <div class="flex flex-col">
                    <p class="font-semibold text-slate-800">Estimated: ${{workItem.EstimatedCost}}</p>
                    <p class="text-sm text-slate-500">Actual: ${{workItem.ActualCost}}</p>
                </div>
            </div>
        </div>
        {{#workItem.Description}}
        <div class="mt-4 pt-4 border-t border-slate-100">
            <p class="text-sm text-slate-500 mb-1">Description</p>
            <p class="text-slate-700">{{workItem.Description}}</p>
        </div>
        {{/workItem.Description}}
    </div>

    <!-- Materials Section -->
    <div class="border-t border-slate-200 pt-6">
        <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
            <i data-lucide="package" class="w-5 h-5 text-slate-400"></i>
            Required Materials
        </h3>

        {{#materials}}
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden mb-4">
            <div class="px-6 py-4">
                <div class="flex items-center justify-between">
                    <div class="flex-1">
                        <h4 class="font-bold text-slate-800">{{MaterialName}}</h4>
                        <div class="flex items-center gap-3 mt-1">
                            <p class="text-sm text-slate-500">{{CategoryName}}</p>
                            <span class="px-2 py-0.5 rounded text-xs font-medium {{materialStatusClass}}">
                                {{Status}}
                            </span>
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="font-semibold text-slate-800">{{RequiredQuantity}} {{UnitName}}</p>
                        <p class="text-sm text-slate-500">Allocated: {{AllocatedQuantity}} {{UnitName}}</p>
                        {{#UnitPrice}}
                        <p class="text-xs text-slate-400 mt-1">@${{UnitPrice}}/{{UnitName}}</p>
                        {{/UnitPrice}}
                    </div>
                </div>
                {{#UnitPrice}}
                <div class="mt-3 pt-3 border-t border-slate-100 flex justify-between text-sm">
                    <span class="text-slate-500">Total Cost:</span>
                    <span class="font-bold text-slate-700">${{totalCost}}</span>
                </div>
                {{/UnitPrice}}
            </div>
        </div>
        {{/materials}}

        {{^materials}}
        <div class="text-center py-12 bg-white border border-dashed border-slate-200 rounded-xl">
            <div class="inline-flex p-4 rounded-full bg-slate-50 text-slate-400 mb-3">
                <i data-lucide="package-x" class="w-8 h-8"></i>
            </div>
            <p class="text-slate-400 mb-3">No materials added yet</p>
            <p class="text-sm text-slate-500">Purchase materials to assign them to this work item</p>
            <a href="/contractor/work-items/{{workItem.WorkItemID}}/purchase" class="inline-block mt-4 text-blue-600 hover:text-blue-700 font-medium">
                Browse Suppliers
            </a>
        </div>
        {{/materials}}
    </div>
</div>
