<div class="max-w-5xl mx-auto space-y-6 pb-24">
    <div class="flex items-center justify-between">
        <a href="/supplier/messages" class="text-sm text-slate-500 hover:text-blue-600 flex items-center gap-1 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Messages
        </a>
        <div class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-[#E8F0FE] text-[#5B8DEF] flex items-center justify-center font-bold">
                {{contractor.Name.0}}
            </div>
            <div>
                <div class="font-bold text-slate-800">{{contractor.Name}}</div>
                <div class="text-xs text-slate-500 flex items-center gap-2">
                    <span class="flex items-center gap-1"><i data-lucide="mail" class="w-3 h-3"></i>{{contractor.Email}}</span>
                </div>
            </div>
        </div>
    </div>

    {{#error}}
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm flex items-center gap-2">
        <i data-lucide="alert-circle" class="w-4 h-4"></i>
        <span>Message cannot be empty.</span>
    </div>
    {{/error}}

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i data-lucide="messages-square" class="w-5 h-5 text-[#5B8DEF]"></i>
                <span class="font-semibold text-slate-800">Conversation</span>
            </div>
            <span class="text-xs text-slate-500">{{contractor.Name}} ↔ You</span>
        </div>

        <div id="messagesContainer" class="h-[420px] overflow-y-auto p-4 bg-slate-50 space-y-3"></div>

        <form id="sendForm" action="/supplier/messages/{{contractor.ContractorID}}" method="POST" class="border-t border-slate-100 p-4 bg-white space-y-3">
            <label for="messageBox" class="text-sm font-medium text-slate-700">Write a message</label>
            <div class="flex flex-col sm:flex-row gap-3">
                <textarea id="messageBox" name="message" rows="3" placeholder="Type your message to {{contractor.Name}}..." required
                    class="flex-1 w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 resize-none"></textarea>
                <button type="submit" class="px-5 py-3 bg-[#5B8DEF] text-white font-semibold rounded-xl shadow-lg shadow-blue-200 hover:bg-[#4A7DE0] transition-colors flex items-center justify-center gap-2">
                    <i data-lucide="send" class="w-4 h-4"></i>
                    <span>Send</span>
                </button>
            </div>
            <p class="text-xs text-slate-500">New messages appear automatically; no need to refresh.</p>
        </form>
    </div>
</div>

<script>
    const contractorId = '{{contractor.ContractorID}}';
    const messagesContainer = document.getElementById('messagesContainer');
    const initialMessages = {{{messagesJson}}} || [];
    let messages = [];
    const messageIds = new Set();

    const escapeHtml = (str) => str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    const renderMessages = () => {
        const html = messages.map(msg => {
            const isMe = msg.sender === 'Supplier';
            const align = isMe ? 'items-end' : 'items-start';
            const bubble = isMe
                ? 'bg-[#5B8DEF] text-white rounded-2xl rounded-br-sm'
                : 'bg-white text-slate-800 border border-slate-200 rounded-2xl rounded-bl-sm';
            const time = new Date(msg.createdAt).toLocaleString();
            return `
                <div class="flex ${align}">
                    <div class="max-w-[80%] px-4 py-3 ${bubble} shadow-sm">
                        <div class="text-xs uppercase tracking-wide ${isMe ? 'text-blue-100' : 'text-slate-400'} mb-1">
                            ${isMe ? 'You' : 'Contractor'}
                        </div>
                        <div class="text-sm leading-relaxed">${escapeHtml(msg.text)}</div>
                        <div class="text-[11px] mt-2 ${isMe ? 'text-blue-100/80' : 'text-slate-400'}">${time}</div>
                    </div>
                </div>
            `;
        }).join('');
        messagesContainer.innerHTML = html || '<div class="text-center text-slate-400 text-sm pt-12">No messages yet. Start the conversation!</div>';
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    };

    const mergeMessages = (list) => {
        list.forEach(m => {
            if (!messageIds.has(m.id)) {
                messageIds.add(m.id);
                messages.push(m);
            }
        });
        renderMessages();
    };

    mergeMessages(initialMessages);

    const pollMessages = async () => {
        try {
            const latest = messages[messages.length - 1];
            const sinceParam = latest ? `?since=${encodeURIComponent(latest.createdAt)}` : '';
            const res = await fetch(`/supplier/messages/${contractorId}/feed${sinceParam}`);
            if (!res.ok) return;
            const data = await res.json();
            if (data && Array.isArray(data.messages)) {
                mergeMessages(data.messages);
            }
        } catch (err) {
            console.error('Polling error', err);
        }
    };

    setInterval(pollMessages, 8000);

    document.getElementById('sendForm').addEventListener('submit', (e) => {
        const val = document.getElementById('messageBox').value.trim();
        if (!val) {
            e.preventDefault();
            alert('Message cannot be empty.');
        }
    });
</script>
