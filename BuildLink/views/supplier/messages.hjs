<div class="space-y-6 max-w-4xl mx-auto">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <div>
            <h2 class="text-2xl font-bold text-slate-800">Messages</h2>
            <p class="text-slate-500 text-sm mt-1">Communicate with your contractors.</p>
        </div>

        <a href="/supplier/dashboard" class="text-sm text-slate-500 hover:text-blue-600 flex items-center gap-1 px-3 py-2 bg-white rounded-lg border border-slate-200 shadow-sm transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back
        </a>
    </div>

    {{^hasConversations}}
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-12 text-center">
        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 text-slate-400">
            <i data-lucide="message-square-off" class="w-8 h-8"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-800">No conversations yet</h3>
        <p class="text-slate-500 mb-6">When contractors message you, they will appear here.</p>
    </div>
    {{/hasConversations}}

    {{#hasConversations}}
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-4 border-b border-slate-100">
            <h3 class="font-bold text-slate-800 flex items-center gap-2">
                <i data-lucide="users" class="w-5 h-5 text-[#5B8DEF]"></i>
                Conversations
            </h3>
        </div>

        <div class="divide-y divide-slate-100">
            {{#conversations}}
            <a href="/supplier/messages/{{ContractorID}}" class="flex items-center gap-4 p-4 hover:bg-slate-50 transition-colors">
                <div class="w-12 h-12 rounded-full bg-[#E8F0FE] text-[#5B8DEF] flex items-center justify-center font-bold text-lg shrink-0">
                    {{Name.0}}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-2">
                        <h4 class="font-bold text-slate-800 truncate">{{Name}}</h4>
                        <span class="text-xs text-slate-400 shrink-0">{{LastMessageTime}}</span>
                    </div>
                    <p class="text-sm text-slate-500 truncate">{{LastMessagePreview}}</p>
                </div>
                <i data-lucide="chevron-right" class="w-5 h-5 text-slate-400 shrink-0"></i>
            </a>
            {{/conversations}}
        </div>
    </div>
    {{/hasConversations}}
</div>
